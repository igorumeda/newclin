###############################################################################
# Clínica SaaS v1.0 — Variáveis de ambiente
#
# 1. Copie este arquivo para `.env.local` (ou `.env`) na raiz do projeto:
#      cp .env.example .env.local
# 2. Preencha com as credenciais reais do seu projeto Supabase.
# 3. Nunca faça commit do arquivo `.env.local` (já está no .gitignore).
#
# Onde encontrar cada valor no Supabase:
#   Painel do projeto → Project Settings → API
#     - Project URL           → NEXT_PUBLIC_SUPABASE_URL
#     - anon public key       → NEXT_PUBLIC_SUPABASE_ANON_KEY
#     - service_role secret   → SUPABASE_SERVICE_ROLE_KEY  (NUNCA expor no client)
#   Painel do projeto → Project Settings → Database
#     - Connection string (URI) → DATABASE_URL (usada apenas para migrations/psql)
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────────────────────
# URL pública da aplicação (usada em links de e-mail, webhooks e fetch server-side).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Clínica SaaS
# Ambiente: development | production
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (banco de dados, autenticação e storage)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo.anon-key
# Chave administrativa: usada somente no backend (convite de usuários, jobs, webhooks).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo.service-role-key

# Conexão direta ao PostgreSQL (migrations, `psql`, `supabase db push`).
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Storage (buckets Supabase Storage — criados pelas migrations)
#   logos       → público   (logotipos das redes)
#   anexos      → privado   (anexos de prontuário; acesso via URL assinada)
#   documentos  → privado   (PDFs de documentos clínicos; URL assinada)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET_LOGOS=logos
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=anexos
SUPABASE_STORAGE_BUCKET_DOCUMENTS=documentos
# Tempo de expiração das URLs assinadas, em segundos (padrão: 10 minutos).
STORAGE_SIGNED_URL_TTL_SECONDS=600
# Limite de tamanho por arquivo em MB (regra de negócio da v1.0: 10 MB).
MAX_UPLOAD_SIZE_MB=10

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (SMTP) — confirmações, lembretes e documentos clínicos
# Usado quando a rede não possui credenciais próprias cadastradas no sistema.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
# true para porta 465 (SSL), false para 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=usuario@exemplo.com
SMTP_PASSWORD=
SMTP_FROM="Clínica SaaS <nao-responder@exemplo.com>"
SMTP_REPLY_TO=

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp (Meta Cloud API ou BSP compatível: Twilio, Z-API, 360dialog)
#   WHATSAPP_PROVIDER=meta | zapi | twilio | 360dialog | noop
#   Use `noop` para desenvolvimento: as mensagens são apenas registradas no log.
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=noop
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token usado pelo provedor para validar o webhook (GET) e assinar o payload (POST).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-este-token
# Segredo opcional para validar a assinatura HMAC (header X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Notificações e jobs assíncronos
# ─────────────────────────────────────────────────────────────────────────────
# Segredo exigido no header `Authorization: Bearer <CRON_SECRET>` para disparar
# os jobs internos (rotas públicas, sem sessão):
#   POST /api/jobs/notificacoes/fila      → processa a fila de mensagens pendentes
#   POST /api/jobs/notificacoes/lembretes → enfileira lembretes (24h antes)
# Deixe vazio em desenvolvimento para permitir chamadas locais; em produção,
# defina um valor forte e configure o mesmo no agendador
# (Supabase Cron/pg_cron, GitHub Actions, Vercel Cron, EasyCron...).
CRON_SECRET=troque-este-segredo
# Antecedência do lembrete automático de consulta, em horas (regra v1.0: 24h).
NOTIFICATION_REMINDER_HOURS=24
# Máximo de mensagens processadas por execução do job.
NOTIFICATION_QUEUE_BATCH_SIZE=25
# Tentativas máximas antes de marcar a mensagem como falha definitiva.
NOTIFICATION_MAX_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────────
# Auditoria e LGPD
# ─────────────────────────────────────────────────────────────────────────────
# Registra em audit_logs a leitura de prontuários (recomendado: true em produção).
AUDIT_LOG_READS=true
# Retenção do log de auditoria, em dias (usado por rotina de expurgo).
AUDIT_RETENTION_DAYS=1825

# ─────────────────────────────────────────────────────────────────────────────
# Desenvolvimento / seeds
# ─────────────────────────────────────────────────────────────────────────────
# Cria dados de demonstração (rede, unidades, profissionais, pacientes) no `db reset`.
SEED_DEMO_DATA=true
# E-mail do primeiro Admin da Rede criado pelo seed.
SEED_ADMIN_EMAIL=admin@clinica.exemplo.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
