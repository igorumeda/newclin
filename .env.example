# =============================================================================
# Clínica — variáveis de ambiente
# Copie para `.env` (ou `.env.local`) e preencha os valores reais.
#   cp .env.example .env
# =============================================================================

# ──────────────────────────────── Aplicação ─────────────────────────────────
APP_NAME="Clínica"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ──────────────────────────────── Banco de dados ─────────────────────────────
# driver: "postgres" (produção) ou "pglite" (desenvolvimento local embarcado).
# Se DATABASE_URL estiver preenchida, "postgres" é assumido automaticamente.
DATABASE_DRIVER="pglite"
DATABASE_URL=""
# Exemplo: postgresql://usuario:senha@localhost:5432/clinica
DATABASE_SSL="false"
DATABASE_POOL_MAX="10"
PGLITE_DATA_DIR="./.pglite"

# ───────────────────────────── Autenticação / sessão ─────────────────────────
# Gere com: openssl rand -base64 48
AUTH_JWT_SECRET="troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"
AUTH_COOKIE_NAME="clinica_sessao"
AUTH_SESSION_TTL_HOURS="12"

# ──────────────────────────────── E-mail (SMTP) ──────────────────────────────
# driver: "smtp" (envio real) ou "log" (apenas registra no console).
EMAIL_DRIVER="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Clínica"
SMTP_FROM_EMAIL="nao-responda@suaclinica.com.br"

# ───────────────────────────────── WhatsApp ──────────────────────────────────
# provider: "meta" (Cloud API), "zapi" ou "log" (desenvolvimento).
# A troca de provedor não exige mudança de código (porta/adaptador).
WHATSAPP_PROVIDER="log"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="defina-um-token-de-verificacao"

# Meta Cloud API
WHATSAPP_META_PHONE_NUMBER_ID=""
WHATSAPP_META_ACCESS_TOKEN=""
WHATSAPP_META_API_VERSION="v21.0"
WHATSAPP_META_TEMPLATE_CONFIRMACAO="confirmacao_consulta"
WHATSAPP_META_TEMPLATE_LEMBRETE="lembrete_consulta"

# Z-API
WHATSAPP_ZAPI_BASE_URL="https://api.z-api.io"
WHATSAPP_ZAPI_INSTANCE_ID=""
WHATSAPP_ZAPI_TOKEN=""
WHATSAPP_ZAPI_CLIENT_TOKEN=""

# ─────────────────────────── Armazenamento de arquivos ───────────────────────
# driver: "local" (disco, para desenvolvimento) ou "s3" (S3/MinIO/R2).
# Estrutura de chaves: logos/{rede_id}/, anexos/{rede_id}/{paciente_id}/,
# documentos/{rede_id}/
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Segredo que assina as URLs temporárias do driver local
STORAGE_SIGNING_SECRET="troque-por-um-segredo-aleatorio"
STORAGE_SIGNED_URL_TTL_SECONDS="900"

S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL=""

# ──────────────────────── Notificações (fila assíncrona) ─────────────────────
NOTIFICACOES_WORKER_ENABLED="true"
NOTIFICACOES_WORKER_INTERVALO_SEGUNDOS="60"
NOTIFICACOES_LEMBRETE_ANTECEDENCIA_HORAS="24"
NOTIFICACOES_MAX_TENTATIVAS="3"
# Segredo exigido pelo endpoint POST /api/v1/cron/notificacoes
CRON_SECRET="troque-por-um-segredo-aleatorio"
